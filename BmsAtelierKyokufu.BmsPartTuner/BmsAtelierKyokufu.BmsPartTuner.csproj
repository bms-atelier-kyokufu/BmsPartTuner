<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <AssemblyName>BmsPartTuner</AssemblyName>
        <RootNamespace>BmsAtelierKyokufu.BmsPartTuner</RootNamespace>
        <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Version>1.0.0</Version>
        <Product>BMS Part Tuner</Product>
        <Copyright>Copyright (c) 2026 Bms Atelier Kyokufu</Copyright>
        <PlatformTarget>x64</PlatformTarget>

        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <SupportedOSPlatform>windows7.0</SupportedOSPlatform>
        <ApplicationIcon>Properties\Resources\icon.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageProjectUrl>https://github.com/bms-atelier-kyokufu/BmsPartTuner</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        
        <!-- Enable writing generated files to disk so the IDE can discover them and resolve errors -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exclude Generated files from standard compilation to avoid duplicate definition errors during msbuild -->
        <Compile Remove="Generated\**\*.cs" />
    </ItemGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\README.md">
          <Pack>True</Pack>
          <PackagePath>\</PackagePath>
        </None>
        <None Include=".copilot\prompts\gen-commit.prompt.md" />
        <None Include=".copilot\prompts\gen-pull-request.prompt.md" />
        <None Include=".github\workflows\ci.yml" />
        <Resource Include="Properties\Resources\icon.ico" />
        <Content Include="Properties\Resources\BmpPartTunerLogo.light-dark-variable.svg">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Properties\Resources\BmpPartTunerLogo_dark.svg">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Properties\Resources\BmpPartTunerLogo_light.svg">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
        <PackageReference Include="NAudio" Version="2.3.0" />
        <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
        <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
        <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BmsAtelierKyokufu.BmsPartTuner.Generators\BmsAtelierKyokufu.BmsPartTuner.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Licenses\**\*.md" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".copilot\copilot-instructions.md" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <Compile Update="Properties\Settings.Designer.cs">
            <DesignTimeSharedInput>True</DesignTimeSharedInput>
            <AutoGen>True</AutoGen>
            <DependentUpon>Settings.settings</DependentUpon>
        </Compile>
        <Compile Update="Views\Windows\MainWindow.xaml.cs">
            <DependentUpon>MainWindow.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Controls\SlideConfirmationControl.xaml.cs">
            <DependentUpon>SlideConfirmationControl.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Controls\SmartFilterChips.xaml.cs">
            <DependentUpon>SmartFilterChips.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Controls\ToastControl.xaml.cs">
            <DependentUpon>ToastControl.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Dialogs\SettingsView.xaml.cs">
            <DependentUpon>SettingsView.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Dialogs\SideSheet.xaml.cs">
            <DependentUpon>SideSheet.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Dialogs\Settings\AboutTab.xaml.cs">
            <DependentUpon>AboutTab.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Dialogs\Settings\GeneralTab.xaml.cs">
            <DependentUpon>GeneralTab.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Dialogs\Settings\LicenseDetailView.xaml.cs">
            <DependentUpon>LicenseDetailView.xaml</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="Properties\Settings.settings">
            <Generator>SettingsSingleFileGenerator</Generator>
            <LastGenOutput>Settings.Designer.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Page Update="Views\Windows\MainWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Controls\SlideConfirmationControl.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Controls\SmartFilterChips.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Controls\ToastControl.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\SettingsView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\SideSheet.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\Settings\AboutTab.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\Settings\GeneralTab.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\Settings\LicenseDetailView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>
</Project>
