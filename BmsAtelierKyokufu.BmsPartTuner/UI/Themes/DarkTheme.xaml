<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Flexoki - Dark Theme Color Palette
        Why: 目への負担を軽減しつつ、コントラスト比を適切に維持したダーク配色を採用します。
        
        このファイルはテーマ切り替え時にリアルタイムで差し替えられます。
        ColorとBrushの両方を定義することで、DynamicResourceが正しく動作します。
    -->

    <!--  Primary Roles  -->
    <Color x:Key="M3PrimaryColor">#66A0C8</Color>
    <Color x:Key="M3OnPrimaryColor">#101A24</Color>
    <Color x:Key="M3PrimaryContainerColor">#163B66</Color>
    <Color x:Key="M3OnPrimaryContainerColor">#C6DDE8</Color>

    <!--  Secondary Roles  -->
    <Color x:Key="M3SecondaryColor">#5ABDAC</Color>
    <Color x:Key="M3OnSecondaryColor">#101F1D</Color>

    <!--  Surface Roles  -->
    <Color x:Key="M3SurfaceColor">#282726</Color>
    <Color x:Key="M3OnSurfaceColor">#E6E4D9</Color>
    <Color x:Key="M3SurfaceVariantColor">#403E3C</Color>
    <Color x:Key="M3OnSurfaceVariantColor">#CECDC3</Color>

    <!--  Outline & Extras  -->
    <Color x:Key="M3OutlineColor">#878580</Color>
    <Color x:Key="M3InverseSurfaceColor">#E6E4D9</Color>
    <Color x:Key="M3InverseOnSurfaceColor">#282726</Color>
    <Color x:Key="M3ErrorColor">#E8705F</Color>
    <Color x:Key="M3OnErrorColor">#261312</Color>

    <!--  Extended Colors  -->
    <Color x:Key="M3BackgroundColor">#100F0F</Color>
    <Color x:Key="M3PrimaryHoverColor">#92BFDB</Color>
    <Color x:Key="M3PrimaryPressedColor">#4385BE</Color>
    <Color x:Key="M3ChipBackgroundColor">#133051</Color>
    <Color x:Key="M3ChipHoverColor">#1A4F8C</Color>
    <Color x:Key="M3PlaceholderBackgroundColor">#343331</Color>
    
    <!--  Warning Colors  -->
    <Color x:Key="M3WarningContainerColor">#59290D</Color>
    <Color x:Key="M3WarningColor">#EC8B49</Color>
    <Color x:Key="M3WarningContainerLightColor">#71320D</Color>
    
    <!--  Drag Speed Indicator Colors  -->
    <Color x:Key="M3DragSpeedFastColor">#EC8B49</Color>
    <Color x:Key="M3DragSpeedFineColor">#5ABDAC</Color>

    <!--  Tertiary Colors  -->
    <Color x:Key="M3TertiaryColor">#A0AF54</Color>
    <Color x:Key="M3OnTertiaryColor">#1A1E0C</Color>
    <Color x:Key="M3TertiaryContainerColor">#3D4C07</Color>
    <Color x:Key="M3OnTertiaryContainerColor">#DDE2B2</Color>

    <Color x:Key="M3SurfaceContainerHighestColor">#343331</Color>

    <!--  Error Colors  -->
    <Color x:Key="M3ErrorContainerColor">#551B18</Color>
    <Color x:Key="M3OnErrorContainerColor">#FFCABB</Color>

    <!--  ========== Brush Definitions ========== -->
    <!--  Primary Brushes  -->
    <SolidColorBrush x:Key="M3PrimaryBrush" Color="#66A0C8" />
    <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#101A24" />
    <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#163B66" />
    <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#C6DDE8" />

    <!--  Surface Brushes  -->
    <SolidColorBrush x:Key="M3SurfaceBrush" Color="#282726" />
    <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#E6E4D9" />
    <SolidColorBrush x:Key="M3SurfaceVariantBrush" Color="#403E3C" />
    <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#CECDC3" />
    <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#343331" />

    <!--  Outline Brushes  -->
    <SolidColorBrush x:Key="M3OutlineBrush" Color="#878580" />

    <!--  Extended Brushes  -->
    <SolidColorBrush x:Key="M3BackgroundBrush" Color="#100F0F" />
    <SolidColorBrush x:Key="M3PrimaryHoverBrush" Color="#92BFDB" />
    <SolidColorBrush x:Key="M3PrimaryPressedBrush" Color="#4385BE" />
    <SolidColorBrush x:Key="M3ChipBackgroundBrush" Color="#133051" />
    <SolidColorBrush x:Key="M3ChipHoverBrush" Color="#1A4F8C" />
    <SolidColorBrush x:Key="M3PlaceholderBackgroundBrush" Color="#343331" />

    <!--  Warning Brushes  -->
    <SolidColorBrush x:Key="M3WarningBrush" Color="#EC8B49" />
    <SolidColorBrush x:Key="M3WarningContainerBrush" Color="#59290D" />
    <SolidColorBrush x:Key="M3WarningContainerLightBrush" Color="#71320D" />

    <!--  Error Brushes  -->
    <SolidColorBrush x:Key="M3ErrorBrush" Color="#E8705F" />
    <SolidColorBrush x:Key="M3OnErrorBrush" Color="#261312" />
    <SolidColorBrush x:Key="M3ErrorContainerBrush" Color="#551B18" />
    <SolidColorBrush x:Key="M3OnErrorContainerBrush" Color="#FFCABB" />

    <!--  Tertiary Brushes  -->
    <SolidColorBrush x:Key="M3TertiaryBrush" Color="#A0AF54" />
    <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="#3D4C07" />
    <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="#DDE2B2" />

    <!--  Inverse Brushes  -->
    <SolidColorBrush x:Key="M3InverseSurfaceBrush" Color="#E6E4D9" />
    <SolidColorBrush x:Key="M3InverseOnSurfaceBrush" Color="#282726" />

    <!--  Drag Speed Brushes  -->
    <SolidColorBrush x:Key="M3DragSpeedFastBrush" Color="#EC8B49" />
    <SolidColorBrush x:Key="M3DragSpeedFineBrush" Color="#5ABDAC" />
</ResourceDictionary>
