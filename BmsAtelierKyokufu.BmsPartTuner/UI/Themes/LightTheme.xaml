<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Flexoki - Light Theme Color Palette
        Why: くすんだ色で見やすいインク風配色 (Flexoki) のライトテーマ
        
        このファイルはテーマ切り替え時にリアルタイムで差し替えられます。
        ColorとBrushの両方を定義することで、DynamicResourceが正しく動作します。
    -->

    <!--  Primary Roles  -->
    <Color x:Key="M3PrimaryColor">#205EA6</Color>
    <Color x:Key="M3OnPrimaryColor">#FFFCF0</Color>
    <Color x:Key="M3PrimaryContainerColor">#92BFDB</Color>
    <Color x:Key="M3OnPrimaryContainerColor">#12253B</Color>

    <!--  Secondary Roles  -->
    <Color x:Key="M3SecondaryColor">#24837B</Color>
    <Color x:Key="M3OnSecondaryColor">#FFFCF0</Color>

    <!--  Surface Roles  -->
    <Color x:Key="M3SurfaceColor">#FFFCF0</Color>
    <Color x:Key="M3OnSurfaceColor">#282726</Color>
    <Color x:Key="M3SurfaceVariantColor">#E6E4D9</Color>
    <Color x:Key="M3OnSurfaceVariantColor">#6F6E69</Color>

    <!--  Outline & Extras  -->
    <Color x:Key="M3OutlineColor">#9F9D96</Color>
    <Color x:Key="M3InverseSurfaceColor">#282726</Color>
    <Color x:Key="M3InverseOnSurfaceColor">#E6E4D9</Color>

    <!--  Extended Colors  -->
    <Color x:Key="M3BackgroundColor">#F2F0E5</Color>
    <Color x:Key="M3PrimaryHoverColor">#3171B2</Color>
    <Color x:Key="M3PrimaryPressedColor">#1A4F8C</Color>
    <Color x:Key="M3ChipBackgroundColor">#C6DDE8</Color>
    <Color x:Key="M3ChipHoverColor">#66A0C8</Color>
    <Color x:Key="M3PlaceholderBackgroundColor">#F2F0E5</Color>

    <!--  Warning Colors  -->
    <Color x:Key="M3WarningColor">#CB6120</Color>
    <Color x:Key="M3WarningContainerColor">#FCC192</Color>
    <Color x:Key="M3WarningContainerLightColor">#FFE7CE</Color>

    <!--  Error Colors  -->
    <Color x:Key="M3ErrorColor">#AF3029</Color>
    <Color x:Key="M3OnErrorColor">#FFFCF0</Color>
    <Color x:Key="M3ErrorContainerColor">#F89A8A</Color>
    <Color x:Key="M3OnErrorContainerColor">#3E1715</Color>

    <!--  Drag Speed Indicator Colors  -->
    <Color x:Key="M3DragSpeedFastColor">#CB6120</Color>
    <Color x:Key="M3DragSpeedFineColor">#2F968D</Color>

    <!--  Tertiary Colors  -->
    <Color x:Key="M3TertiaryColor">#66800B</Color>
    <Color x:Key="M3OnTertiaryColor">#FFFCF0</Color>
    <Color x:Key="M3TertiaryContainerColor">#BEC97E</Color>
    <Color x:Key="M3OnTertiaryContainerColor">#252D09</Color>

    <Color x:Key="M3SurfaceContainerHighestColor">#DAD8CE</Color>

    <!--  ========== Brush Definitions ==========  -->
    <!--  Primary Brushes  -->
    <SolidColorBrush x:Key="M3PrimaryBrush" Color="#205EA6" />
    <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#FFFCF0" />
    <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#92BFDB" />
    <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#12253B" />

    <!--  Surface Brushes  -->
    <SolidColorBrush x:Key="M3SurfaceBrush" Color="#FFFCF0" />
    <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#282726" />
    <SolidColorBrush x:Key="M3SurfaceVariantBrush" Color="#E6E4D9" />
    <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#6F6E69" />
    <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#DAD8CE" />

    <!--  Outline Brushes  -->
    <SolidColorBrush x:Key="M3OutlineBrush" Color="#9F9D96" />

    <!--  Extended Brushes  -->
    <SolidColorBrush x:Key="M3BackgroundBrush" Color="#F2F0E5" />
    <SolidColorBrush x:Key="M3PrimaryHoverBrush" Color="#3171B2" />
    <SolidColorBrush x:Key="M3PrimaryPressedBrush" Color="#1A4F8C" />
    <SolidColorBrush x:Key="M3ChipBackgroundBrush" Color="#C6DDE8" />
    <SolidColorBrush x:Key="M3ChipHoverBrush" Color="#66A0C8" />
    <SolidColorBrush x:Key="M3PlaceholderBackgroundBrush" Color="#F2F0E5" />

    <!--  Warning Brushes  -->
    <SolidColorBrush x:Key="M3WarningBrush" Color="#CB6120" />
    <SolidColorBrush x:Key="M3WarningContainerBrush" Color="#FCC192" />
    <SolidColorBrush x:Key="M3WarningContainerLightBrush" Color="#FFE7CE" />

    <!--  Error Brushes  -->
    <SolidColorBrush x:Key="M3ErrorBrush" Color="#AF3029" />
    <SolidColorBrush x:Key="M3OnErrorBrush" Color="#FFFCF0" />
    <SolidColorBrush x:Key="M3ErrorContainerBrush" Color="#F89A8A" />
    <SolidColorBrush x:Key="M3OnErrorContainerBrush" Color="#3E1715" />

    <!--  Tertiary Brushes  -->
    <SolidColorBrush x:Key="M3TertiaryBrush" Color="#66800B" />
    <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="#BEC97E" />
    <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="#252D09" />

    <!--  Inverse Brushes  -->
    <SolidColorBrush x:Key="M3InverseSurfaceBrush" Color="#282726" />
    <SolidColorBrush x:Key="M3InverseOnSurfaceBrush" Color="#E6E4D9" />

    <!--  Drag Speed Brushes  -->
    <SolidColorBrush x:Key="M3DragSpeedFastBrush" Color="#CB6120" />
    <SolidColorBrush x:Key="M3DragSpeedFineBrush" Color="#2F968D" />
</ResourceDictionary>
