<Window
    x:Class="BmsAtelierKyokufu.BmsPartTuner.UI.Views.Windows.CrashReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="エラーが発生しました - BMS Part Tuner"
    Width="680"
    Height="520"
    MinWidth="550"
    MinHeight="400"
    Background="#121212"
    Foreground="#E3E3E3"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#E3E3E3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EF5350" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C62828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- ヘッダー情報 -->
            <RowDefinition Height="Auto" />
            <!-- アクションバー (ログ操作) -->
            <RowDefinition Height="Auto" />
            <!-- 例外詳細テキストエリア -->
            <RowDefinition Height="*" />
            <!-- フッター (終了ボタン) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー情報 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- アプリロゴ -->
            <Image
                x:Name="LogoImage"
                Grid.Column="0"
                Width="100"
                Height="100"
                Margin="0,0,20,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#FF8989"
                        Text="⚠ " />
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#FF8989"
                        Text="予期せぬエラーが発生しました" />
                </StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="13"
                    Foreground="#A0A0A0"
                    LineHeight="18"
                    Text="アプリケーションの実行中に問題が発生し、処理を続行できなくなりました。&#x0a;エラーの詳細は以下の通りです。開発者へ報告する際は「詳細をコピー」ボタンをご利用ください。&#x0a;エラーのログは以下の場所に保存されています："
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- アクションバー (ログ操作) -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="12"
            Background="#1A1A1A"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#808080"
                        Text="エラーログの保存先" />
                    <TextBox
                        x:Name="LogPathTextBox"
                        Margin="0,4,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Foreground="#E3E3E3"
                        IsReadOnly="True"
                        Text="C:\Users\...\Logs\crash_xxxx.log"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        x:Name="OpenFolderButton"
                        Margin="0,0,8,0"
                        Click="OpenFolderButton_Click"
                        Content="📁 フォルダを開く"
                        FontSize="12"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        x:Name="CopyLogButton"
                        Click="CopyLogButton_Click"
                        Content="📋 詳細をコピー"
                        FontSize="12"
                        Style="{StaticResource ModernButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 例外詳細テキストエリア -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,16"
            Background="#1E1E1E"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="8">
            <TextBox
                x:Name="DetailsTextBox"
                Margin="8"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Consolas, Courier New, monospace"
                FontSize="12"
                Foreground="#CCCCCC"
                AcceptsReturn="True"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="System.NullReferenceException: ..." />
        </Border>

        <!-- フッター (終了ボタン) -->
        <Grid Grid.Row="3">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#666666"
                Text="BMS Part Tuner" />
            <Button
                x:Name="ExitButton"
                HorizontalAlignment="Right"
                Width="160"
                Height="36"
                Click="ExitButton_Click"
                Content="アプリケーションを終了"
                FontSize="13"
                Style="{StaticResource AccentButton}" />
        </Grid>
    </Grid>
</Window>
