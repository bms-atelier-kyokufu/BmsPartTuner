<Window
    x:Class="BmsAtelierKyokufu.BmsPartTuner.UI.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:BmsAtelierKyokufu.BmsPartTuner.UI.Behaviors"
    xmlns:controls="clr-namespace:BmsAtelierKyokufu.BmsPartTuner.UI.Views.Controls"
    xmlns:dialogs="clr-namespace:BmsAtelierKyokufu.BmsPartTuner.UI.Views.Dialogs"
    xmlns:converters="clr-namespace:BmsAtelierKyokufu.BmsPartTuner.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:BmsAtelierKyokufu.BmsPartTuner.Infrastructure.UI"
    Title="BMS Part Tuner"
    Width="1200"
    Height="800"
    MinWidth="1000"
    MinHeight="700"
    Background="{DynamicResource M3BackgroundBrush}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:FilePlayingConverter x:Key="FilePlayingConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <!--  ルートグリッド: メインコンテンツ + サイドシートオーバーレイ  -->
    <Grid>
        <!--  グローバルプログレスバー (ウィンドウ上部に固定)  -->
        <ProgressBar
            Height="4"
            VerticalAlignment="Top"
            Panel.ZIndex="1000"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource M3PrimaryBrush}"
            IsIndeterminate="{Binding IsGlobalProgressIndeterminate}"
            Maximum="100"
            Minimum="0"
            Value="{Binding GlobalProgressValue}"
            Visibility="{Binding IsGlobalProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!--  キャンセルバナー (Google UX準拠、プログレスバーの直下に配置)  -->
        <Border
            Height="40"
            Margin="0,4,0,0"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="{DynamicResource M3SurfaceContainerHighestBrush}"
            BorderBrush="{DynamicResource M3OutlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,0"
            Panel.ZIndex="1000"
            Visibility="{Binding IsGlobalProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Resources>
                <Style x:Key="M3DestructiveTextButton" TargetType="Button" BasedOn="{StaticResource M3TextButton}">
                    <Setter Property="Foreground" Value="{DynamicResource M3ErrorBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border
                                        x:Name="StateLayer"
                                        Background="{DynamicResource M3ErrorBrush}"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="StateLayer"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.08"
                                                        Duration="0:0:0.1">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="StateLayer"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0"
                                                        Duration="0:0:0.1">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="StateLayer"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.12"
                                                        Duration="0:0:0.05" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="StateLayer"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.08"
                                                        Duration="0:0:0.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.38" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock
                        Text="⌛"
                        FontSize="14"
                        Foreground="{DynamicResource M3PrimaryBrush}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding StatusMessage}"
                        FontSize="13"
                        Foreground="{DynamicResource M3OnSurfaceBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="600" />
                    <TextBlock
                        Text="{Binding GlobalProgressValue, StringFormat=' ({0}%)'}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource M3PrimaryBrush}"
                        VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalProgressIndeterminate}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{Binding CancelActiveTaskCommand}"
                    Content="キャンセル"
                    Style="{StaticResource M3DestructiveTextButton}"
                    VerticalAlignment="Center"
                    Height="32"
                    Padding="8,0" />
            </Grid>
        </Border>

        <!--  メイングリッド: 3カラムレイアウト  -->
        <!--  メイングリッド: 3カラムレイアウト  -->
        <Grid IsEnabled="{Binding IsGlobalProgressVisible, Converter={StaticResource InverseBooleanConverter}}">
            <Grid.ColumnDefinitions>
                <!--  左: メイン操作エリア (可変)  -->
                <ColumnDefinition Width="*" MinWidth="500" />
                <!--  中央: セパレータ  -->
                <ColumnDefinition Width="Auto" />
                <!--  右: サイドパネル (360dp固定)  -->
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!--  ========== 左側: メイン操作エリア ==========  -->
            <DockPanel Grid.Column="0" Margin="20">
                <!--  #region 入力パネル  -->
                <StackPanel DockPanel.Dock="Top">
                    <!--  ヘッダー / 設定  -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="設定と実行" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        <!--  設定ボタン (歯車アイコン)  -->
                        <Button
                            x:Name="SettingsButton"
                            HorizontalAlignment="Right"
                            Width="44"
                            Height="44"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource M3IconButton}"
                            ToolTip="設定">
                            <TextBlock
                                FontSize="20"
                                Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                Text="⚙" />
                        </Button>
                    </Grid>

                    <!--  入力BMSファイル  -->
                    <StackPanel>
                        <TextBox
                            x:Name="InputFilePathTextBox"
                            ui:TextBoxHelper.BrowseCommand="{Binding FileOperations.BrowseInputFileCommand}"
                            ui:TextBoxHelper.Label="入力BMS/BMSONファイル (.bms/.bme/.bml/.pms/.bmson)"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource Material.Styles.TextBox.FilePath}">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="FileOperations.InputPath"
                                    UpdateSourceTrigger="PropertyChanged"
                                    ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <DataErrorValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Behaviors>
                                <behaviors:FloatingLabelBehavior LabelText="入力BMS/BMSONファイル (.bms/.bme/.bml/.pms/.bmson)" />
                                <behaviors:EscapeToClearBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </StackPanel>

                    <!--  出力BMSファイル  -->
                    <StackPanel>
                        <TextBox
                            x:Name="OutputFilePathTextBox"
                            ui:TextBoxHelper.BrowseCommand="{Binding FileOperations.BrowseOutputFileCommand}"
                            ui:TextBoxHelper.Label="出力BMSファイル"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource Material.Styles.TextBox.FilePath}">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="FileOperations.OutputPath"
                                    UpdateSourceTrigger="PropertyChanged"
                                    ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <DataErrorValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Behaviors>
                                <behaviors:FloatingLabelBehavior LabelText="出力BMSファイル" />
                                <behaviors:EscapeToClearBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </StackPanel>

                    <!--  相関係数 & 定義範囲 & 物理削除 (横並び)  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  相関係数 (✨AI統合型)  -->
                        <Grid Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBox
                                x:Name="R2TextBox"
                                ui:TextBoxHelper.AiOptimizationCommand="{Binding ExecuteThresholdOptimizationCommand}"
                                ui:TextBoxHelper.HasAiOptimization="True"
                                ui:TextBoxHelper.Label="マッチ許容度 (1-100)"
                                IsEnabled="{Binding Optimization.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource R2TextBox}"
                                Text="{Binding Optimization.R2Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImeOffBehavior />
                                    <behaviors:NumericInputBehavior AllowDecimal="False" AllowNegative="False" />
                                    <behaviors:UnitSuffixBehavior Unit="%" />
                                    <behaviors:VirtualSliderBehavior
                                        IsIntegerMode="True"
                                        MaxValue="100"
                                        MinValue="0"
                                        Sensitivity="1" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <Label
                                Margin="167,0,-87,0"
                                VerticalAlignment="Center"
                                Content="以上"
                                Foreground="{DynamicResource M3OutlineBrush}" />
                        </Grid>

                        <!--  定義範囲  -->
                        <StackPanel Grid.Column="2">
                            <Label Content="WAVファイルの定義範囲 (00=ファイルから推定)" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    x:Name="Definition_Start"
                                    Width="50"
                                    IsEnabled="{Binding Optimization.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    MaxLength="2"
                                    Style="{StaticResource NumericTextBox}"
                                    Text="{Binding Optimization.DefinitionStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ImeOffBehavior />
                                        <behaviors:Base62InputBehavior />
                                        <behaviors:ZeroPadBehavior PadLength="2" />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                                <Label
                                    VerticalAlignment="Center"
                                    Content="～"
                                    FontSize="16"
                                    Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <TextBox
                                    x:Name="Definition_End"
                                    Width="50"
                                    IsEnabled="{Binding Optimization.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    MaxLength="2"
                                    Style="{StaticResource NumericTextBox}"
                                    Text="{Binding Optimization.DefinitionEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ImeOffBehavior />
                                        <behaviors:Base62InputBehavior />
                                        <behaviors:ZeroPadBehavior PadLength="2" />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </StackPanel>
                        </StackPanel>

                        <!--  物理削除オプション  -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Label Content="物理削除" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                            <ToggleButton
                                IsChecked="{Binding Optimization.IsPhysicalDeletionEnabled}"
                                IsEnabled="{Binding Optimization.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource M3ToggleSwitch}"
                                ToolTip="未使用の音源ファイルを物理削除する (危険)" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,4,0,20" Background="{DynamicResource M3OutlineVariantBrush}" Height="1" />

                    <!--  実行アクション  -->
                    <Grid Margin="0,0,0,24">
                        <!--  通常の処理開始ボタン  -->
                        <Button
                            x:Name="DefinitionReductButton"
                            Height="44"
                            Command="{Binding ExecuteReductionCommand}"
                            Content="処理を開始"
                            IsEnabled="{Binding Optimization.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource M3PrimaryButton}"
                            Visibility="{Binding Notification.IsSlideConfirmationVisible, Converter={StaticResource InverseBooleanConverter}}" />

                        <!--  スライド確認UI (上書き時のみ表示)  -->
                        <Grid Visibility="{Binding Notification.IsSlideConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:SlideConfirmationControl
                                x:Name="SlideConfirmation"
                                Direction="{Binding Optimization.SlideDirection}"
                                SlideCancelled="SlideConfirmation_Cancelled"
                                SlideCompleted="SlideConfirmation_Completed"
                                SlideInstructionText="{Binding Optimization.SlideInstructionText}" />

                            <!--  キャンセルボタン  -->
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Width="44"
                                Height="44"
                                Command="{Binding CancelSlideConfirmationInternalCommand}"
                                Style="{StaticResource M3IconButton}"
                                ToolTip="キャンセル">
                                <TextBlock
                                    FontSize="20"
                                    Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                    Text="✕" />
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
                <!--  #endregion  -->

                <!--  #region ファイルリスト  -->
                <DockPanel>
                    <!--  ファイルリスト ヘッダー＆フィルターエリア  -->
                    <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                        <TextBlock Text="ファイルプレビュー (確認用)" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="※ リストでの絞り込みや選択は処理に影響しません" FontSize="12" Foreground="{DynamicResource M3OutlineBrush}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  検索バー  -->
                            <TextBox
                                x:Name="FilterTextBox"
                                ui:TextBoxHelper.Label="ファイル名で検索"
                                Style="{StaticResource Material.Styles.TextBox.Search}"
                                Text="{Binding BmsDefinitionManager.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="FilterTextBox_TextChanged">
                                <i:Interaction.Behaviors>
                                    <behaviors:FloatingLabelBehavior LabelText="ファイル名で検索" />
                                    <behaviors:EscapeToClearBehavior />
                                </i:Interaction.Behaviors>
                            </TextBox>

                            <!--  mBMplay再生ボタン  -->
                            <Button
                                x:Name="TestPlayButton"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                Margin="12,0,0,0"
                                Command="{Binding TestPlayCommand}"
                                Style="{StaticResource M3IconButton}"
                                ToolTip="mBMplayで再生">
                                <TextBlock
                                    FontSize="20"
                                    Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                    Text="▶" />
                            </Button>
                        </Grid>

                        <!--  楽器選択モード切り替えとラベル  -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="楽器フィルター"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource M3OnSurfaceBrush}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock
                                    Text="マルチ選択"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource M3OutlineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BmsDefinitionManager.IsSingleChipSelection}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ToggleButton
                                    IsChecked="{Binding BmsDefinitionManager.IsSingleChipSelection, Mode=TwoWay}"
                                    Style="{StaticResource M3ToggleSwitch}"
                                    ToolTip="オンにするとシングル選択、オフにするとマルチ選択になります。" />

                                <TextBlock
                                    Text="シングル選択"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource M3OutlineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BmsDefinitionManager.IsSingleChipSelection}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!--  Smart Filter Chips (Instrument-based)  -->
                        <controls:SmartFilterChips
                            x:Name="FilterChipsControl"
                            ChipClick="FilterChip_Click"
                            Chips="{Binding BmsDefinitionManager.FilterChips}" />
                    </StackPanel>



                    <!--  ファイルリスト  -->
                    <ListView
                        x:Name="FilesListView"
                        SelectionMode="Single"
                        ItemsSource="{Binding BmsDefinitionManager.FileListItems}"
                        SelectedItem="{Binding BmsDefinitionManager.SelectedFile}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Num}"
                                    Header="No." />
                                <GridViewColumn
                                    Width="450"
                                    Header="ファイル名">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="430" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Name}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Width="28"
                                                    Height="28"
                                                    Command="{Binding DataContext.BmsDefinitionManager.TogglePlaybackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="再生/停止">
                                                    <Button.Tag>
                                                        <MultiBinding Converter="{StaticResource FilePlayingConverter}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="DataContext.BmsDefinitionManager.PlayingFileName" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                        </MultiBinding>
                                                    </Button.Tag>
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource M3IconButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Content" Value="▶" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Content" Value="■" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <!--  #endregion  -->
            </DockPanel>

            <!--  ========== 右側: 常時表示サイドパネル ==========  -->
            <!--  #region 解析結果パネル  -->
            <Border Grid.Column="2" Style="{DynamicResource SidePanel}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!--  ヘッダー  -->
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource M3OnSurfaceBrush}"
                                Text="解析結果" />

                            <!--  結果カード  -->
                            <Border Style="{DynamicResource ResultCard}" Visibility="{Binding Notification.IsResultCardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <!--  ヘッダー  -->
                                    <Grid Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="24"
                                                Foreground="{DynamicResource M3PrimaryBrush}"
                                                Text="{Binding Notification.ResultIcon}" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                Text="最適化サマリー" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Width="32"
                                            Height="32"
                                            Command="{Binding HideResultCardInternalCommand}"
                                            Style="{StaticResource M3IconButton}"
                                            ToolTip="閉じる">
                                            <TextBlock
                                                FontSize="16"
                                                Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                Text="✕" />
                                        </Button>
                                    </Grid>

                                    <!--  推奨しきい値 (大見出し)  -->
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="32"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource M3PrimaryBrush}"
                                        Text="{Binding Notification.ResultThreshold}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,0,0,16"
                                        FontSize="12"
                                        Foreground="{DynamicResource M3OutlineBrush}"
                                        Text="{Binding Notification.ResultThresholdLabel}"
                                        TextAlignment="Center" />

                                    <Separator Margin="0,0,0,16" />

                                    <!--  削減後ファイル数 (サマリー)  -->
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource M3OnSurfaceBrush}"
                                        Text="{Binding Notification.ResultSummary}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,0,0,16"
                                        FontSize="12"
                                        Foreground="{DynamicResource M3OutlineBrush}"
                                        Text="削減後ファイル数"
                                        TextAlignment="Center" />

                                    <Separator Margin="0,0,0,16" />

                                    <!--  追加情報 (Simulation/Reduction Rate)  -->
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        FontSize="14"
                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                        Text="{Binding Notification.ResultReduction}"
                                        TextAlignment="Center" />

                                    <!--  詳細情報 (Memory/Time)  -->
                                    <Separator Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource M3OutlineBrush}"
                                            Text="使用メモリ" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="12"
                                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                            Text="{Binding Notification.ResultMargin}" />
                                    </Grid>

                                    <Grid>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource M3OutlineBrush}"
                                            Text="処理時間" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="12"
                                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                            Text="{Binding Notification.ResultTime}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  プレースホルダー (結果なし時)  -->
                            <Border
                                Padding="30"
                                Background="{DynamicResource M3PlaceholderBackgroundBrush}"
                                CornerRadius="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notification.IsResultCardVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,16"
                                        FontSize="48"
                                        Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                        Text="📊"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{DynamicResource M3OutlineBrush}"
                                        Text="処理結果がここに表示されます"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                x:Name="StatusLabel"
                                Margin="0,20,0,12"
                                FontSize="12"
                                Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                Text="{Binding Optimization.StatusMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!--  #endregion  -->
        </Grid>

        <!--  ========== トースト通知 (右下) ==========  -->
        <controls:ToastControl
            x:Name="AppToastControl"
            IsError="{Binding Notification.IsToastError}"
            IsToastVisible="{Binding Notification.IsToastVisible}"
            ToastIcon="{Binding Notification.ToastIcon}"
            ToastMessage="{Binding Notification.ToastMessage}" />

        <!--  ========== 設定サイドシート ==========  -->
        <dialogs:SideSheet
            x:Name="SettingsSideSheet"
            IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
            SheetWidth="400">
            <dialogs:SettingsView CloseCommand="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DataContext="{Binding Settings}" />
        </dialogs:SideSheet>

        <!--  ========== チュートリアルオーバーレイ ==========  -->
        <dialogs:TutorialOverlay
            x:Name="TutorialOverlay"
            DataContext="{Binding Tutorial}"
            Visibility="{Binding DataContext.IsTutorialVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"
            Panel.ZIndex="2000" />
    </Grid>
</Window>
