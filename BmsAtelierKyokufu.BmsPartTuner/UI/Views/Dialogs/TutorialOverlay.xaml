<UserControl x:Class="BmsAtelierKyokufu.BmsPartTuner.UI.Views.Dialogs.TutorialOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#80000000"
             Visibility="Collapsed">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Modal Card -->
        <Border Width="600" Height="400" 
                Background="{DynamicResource M3SurfaceBrush}" 
                CornerRadius="24"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Effect="{DynamicResource M3Elevation3}">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Carousel Content -->
                <Grid Grid.Row="0" DataContext="{Binding CurrentStepData}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Logo Container (Only visible on Step 1) -->
                        <Grid Height="80" Margin="0,0,0,24">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsFirstStep, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            
                            <!-- SVG Logo for the first step -->
                            <svgc:SvgViewbox x:Name="LogoViewbox"
                                             Width="200"
                                             Height="80"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Title}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource M3OnSurfaceBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding Description}" 
                                   FontSize="16" 
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" 
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </StackPanel>
                </Grid>

                <!-- Navigation Controls -->
                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{Binding SkipCommand}" 
                            Content="スキップ" 
                            Style="{StaticResource M3TextButton}"
                            Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>

                    <!-- Indicator -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                            <Run Text="Step " />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayStepIndex}" Margin="0,0,2,0" />
                        <TextBlock Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text=" / " />
                        <TextBlock Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding TotalSteps}" />
                    </StackPanel>

                    <!-- Next Button -->
                    <Button Grid.Column="2" 
                            Command="{Binding NextCommand}" 
                            Content="{Binding NextButtonText}" 
                            Style="{StaticResource M3PrimaryButton}" 
                            Width="120"
                            Height="44"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
