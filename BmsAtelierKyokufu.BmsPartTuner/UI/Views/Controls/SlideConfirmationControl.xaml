<UserControl
    x:Class="BmsAtelierKyokufu.BmsPartTuner.UI.Views.Controls.SlideConfirmationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="44"
    d:DesignWidth="600"
    MinWidth="120"
    mc:Ignorable="d">

    <!--  スライド確認UI (上書き確認用)  -->
    <Border
        x:Name="SlideConfirmationPanel"
        Height="44"
        Background="{DynamicResource M3WarningContainerBrush}"
        BorderThickness="0"
        CornerRadius="12"
        Cursor="Hand"
        MouseLeave="SlideConfirmationPanel_MouseLeave"
        MouseLeftButtonDown="SlideConfirmationPanel_MouseLeftButtonDown"
        MouseLeftButtonUp="SlideConfirmationPanel_MouseLeftButtonUp"
        MouseMove="SlideConfirmationPanel_MouseMove">
        <Grid>
            <!--  レール背景およびテキストグリッド  -->
            <Grid x:Name="RailGrid" Margin="2" IsHitTestVisible="False">
                <!--  レール背景  -->
                <Border
                    Background="{DynamicResource M3WarningContainerLightBrush}"
                    CornerRadius="10" />

                <!--  背景テキスト (通常時・未スライド部分用、ダーク色)  -->
                <TextBlock
                    x:Name="BackgroundText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{DynamicResource M3OutlineBrush}"
                    Text="{Binding SlideInstructionText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="BackgroundTextTransform" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <!--  プログレッシブ・フィル (左から右へ満たされる背景、スライダーと同じ色)  -->
            <Border
                x:Name="ProgressiveFill"
                Width="0"
                Margin="2"
                HorizontalAlignment="Left"
                Background="{DynamicResource M3WarningBrush}"
                CornerRadius="10"
                ClipToBounds="True"
                IsHitTestVisible="False">
                <!--  スライドして現れる文字用のコンテナ。親コントロールと同じ幅にしておくことで位置を完全に一致させる  -->
                <Grid
                    x:Name="ProgressiveFillGrid"
                    Width="{Binding ElementName=RailGrid, Path=ActualWidth}"
                    HorizontalAlignment="Left">
                    <!--  反転テキスト (スライド済み部分用、白色)  -->
                    <TextBlock
                        x:Name="ForegroundText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{Binding SlideInstructionText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ForegroundTextTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Border>

            <!--  スライダーツマミ  -->
            <Border
                x:Name="SlideThumb"
                Width="{Binding ThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="40"
                HorizontalAlignment="Left"
                Background="{DynamicResource M3WarningBrush}"
                CornerRadius="10"
                IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbTransform" />
                </Border.RenderTransform>

                <TextBlock
                    x:Name="ArrowText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="35"
                    Foreground="White"
                    IsHitTestVisible="False"
                    Text="➡" />
            </Border>
        </Grid>
    </Border>
</UserControl>
