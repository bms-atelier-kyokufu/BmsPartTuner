## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# --- Build results ---
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# --- IDE and Editor Specific ---
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.tss

# --- NuGet ---
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
packages/

# --- Tests and Code Coverage ---
TestResults/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# --- Python (Scratch / Helper Scripts) ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- OS Specific ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Miscellaneous / Temp files ---
*.log
*.tmp
tmp/

# --- Local temporary test folders ---
/wav_a/
/output/
/[BMS] Vermilion Catastrophe/

# --- Source Generator Outputs ---
[Gg]enerated/

